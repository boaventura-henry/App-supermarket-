# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Postgres / Prisma - backend only.
# Configure real values in Vercel Project Settings > Environment Variables.
# DATABASE_URL: pooled connection for serverless runtime.
# DIRECT_URL: direct connection for controlled migrations.
DATABASE_URL=
DIRECT_URL=

# Gradual migration flag. Keep false until existing lists are imported.
VITE_USE_REMOTE_LISTS=false

# Frontend feature flag. Keep false until product CRUD is intentionally switched to the API.
VITE_USE_REMOTE_PRODUCTS=false
