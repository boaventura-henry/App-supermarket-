# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Postgres / Prisma - backend only.
# Configure real values in Vercel Project Settings > Environment Variables.
# DATABASE_URL: pooled connection for serverless runtime.
# DIRECT_URL: direct connection for controlled migrations.
# Never expose these values to React/Vite and never prefix them with VITE_.
DATABASE_URL=
DIRECT_URL=

# Supabase client - public frontend values.
# These are safe for the browser only when Row Level Security policies are enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_DEBUG_SUPABASE=false
VITE_ENABLE_LOCAL_FALLBACK=false

# Deprecated migration flags kept only for old deployments. The current web app uses
# Supabase Client directly when VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are set.
VITE_USE_REMOTE_LISTS=false
VITE_USE_REMOTE_PRODUCTS=false
VITE_USE_REMOTE_PRICE_HISTORY=false
