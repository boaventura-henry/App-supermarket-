# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase Postgres / Prisma backend only.
# Configure real values in Vercel Project Settings > Environment Variables.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth backend configuration. The anon key is public by design, but keep backend variables outside the browser bundle.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET are intentionally not used by the current implementation.
# Do not add either variable unless a reviewed backend-only feature requires it.

# Supabase Auth public configuration for the browser. These are public anon values, not service-role secrets.
# Supabase Realtime also uses these values in the browser; never expose service role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Frontend feature flag. Use true to load/create/update lists through the authenticated API.
VITE_USE_REMOTE_LISTS=false

# Frontend feature flag. Keep false until product CRUD is intentionally switched to the API.
VITE_USE_REMOTE_PRODUCTS=false

# Frontend feature flag. Keep false until price history is intentionally switched to the API.
VITE_USE_REMOTE_PRICE_HISTORY=false

# Frontend feature flag. Keep false unless you want to show the localStorage import tool.
VITE_ENABLE_LOCAL_DATA_MIGRATION=false

# Frontend feature flag. Keep false to use the legacy local auth flow.
VITE_USE_SUPABASE_AUTH=false
