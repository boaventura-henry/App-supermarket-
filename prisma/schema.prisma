generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId           String?             @unique
  name               String
  email              String              @unique
  passwordHash       String
  securityAnswerHash String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lists              ShoppingList[]
  products           Product[]
  priceHistory       PriceHistory[]
  passkeys           PasskeyCredential[]
  sharedListAccess   SharedListAccess[]
  sentInvites        ListInvite[]        @relation("SentListInvites")
  receivedInvites    ListInvite[]        @relation("ReceivedListInvites")
  notifications      Notification[]

  @@map("users")
}

enum ListAccessRole {
  VIEWER
  EDITOR
}

enum ListInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

enum NotificationType {
  LIST_INVITE_RECEIVED
  LIST_INVITE_ACCEPTED
  LIST_INVITE_DECLINED
  LIST_SHARED_ACCESS_REMOVED
  PRODUCT_UPDATED
  PRODUCT_PURCHASED
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model ShoppingList {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId  String?        @unique
  userId    String         @db.Uuid
  name      String
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  history   PriceHistory[]
  sharedAccess SharedListAccess[]
  invites   ListInvite[]

  @@index([userId])
  @@map("shopping_lists")
}

model SharedListAccess {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId    String         @db.Uuid
  userId    String         @db.Uuid
  role      ListAccessRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  list      ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("shared_list_access")
}

model ListInvite {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId          String           @db.Uuid
  invitedEmail    String
  invitedUserId   String?          @db.Uuid
  invitedByUserId String           @db.Uuid
  role            ListAccessRole
  status          ListInviteStatus @default(PENDING)
  token           String?          @unique
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  list            ShoppingList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  invitedUser     User?            @relation("ReceivedListInvites", fields: [invitedUserId], references: [id], onDelete: SetNull)
  invitedByUser   User             @relation("SentListInvites", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([listId, status])
  @@index([invitedEmail, status])
  @@index([invitedUserId, status])
  @@map("list_invites")
}

model Product {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId    String?      @unique
  userId      String       @db.Uuid
  listId      String       @db.Uuid
  name        String
  brand       String       @default("")
  quantity    Decimal?     @db.Decimal(12, 3)
  unitPrice   Decimal?     @db.Decimal(12, 2)
  supermarket String       @default("")
  purchased   Boolean      @default(false) @map("isBought")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@index([userId])
  @@index([listId, purchased, sortOrder], map: "products_listId_isBought_sortOrder_idx")
  @@map("products")
}

model PriceHistory {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId    String?       @unique
  userId      String        @db.Uuid
  listId      String?       @db.Uuid
  productId   String?       @db.Uuid
  productName String
  brand       String        @default("")
  quantity    Decimal?      @db.Decimal(12, 3)
  price       Decimal       @db.Decimal(12, 2)
  supermarket String        @default("")
  createdAt   DateTime      @default(now()) @map("recordedAt")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "price_history_userId_recordedAt_idx")
  @@index([listId])
  @@index([productId])
  @@map("price_history")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PasskeyCredential {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId   String?  @unique
  userId     String   @db.Uuid
  email      String
  rawId      String
  label      String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawId])
  @@index([userId])
  @@map("passkey_credentials")
}
