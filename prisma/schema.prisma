generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id           String              @id @default(uuid()) @db.Uuid
  legacyId     String?             @unique @map("legacy_id")
  email        String              @unique
  name         String
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  lists        ShoppingList[]
  ownedShares  ListShare[]         @relation("ListShareOwner")
  sharedLists  ListShare[]         @relation("ListShareRecipient")
  products     Product[]
  priceHistory PriceHistory[]
  passkeys     PasskeyCredential[]

  @@map("profiles")
}

model ShoppingList {
  id        String         @id @default(uuid()) @db.Uuid
  legacyId  String?        @unique @map("legacy_id")
  userId    String         @map("user_id") @db.Uuid
  name      String
  color     String
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  history   PriceHistory[]
  shares    ListShare[]

  @@index([userId])
  @@map("shopping_lists")
}

model ListShare {
  id           String           @id @default(uuid()) @db.Uuid
  listId       String           @map("list_id") @db.Uuid
  ownerUserId  String           @map("owner_user_id") @db.Uuid
  sharedUserId String           @map("shared_user_id") @db.Uuid
  permission   SharePermission  @default(viewer)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  list         ShoppingList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  owner        Profile          @relation("ListShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sharedUser   Profile          @relation("ListShareRecipient", fields: [sharedUserId], references: [id], onDelete: Cascade)

  @@unique([listId, sharedUserId])
  @@index([ownerUserId])
  @@index([sharedUserId])
  @@map("list_shares")
}

enum SharePermission {
  viewer
  editor
}

model Product {
  id           String         @id @default(uuid()) @db.Uuid
  legacyId     String?        @unique @map("legacy_id")
  listId       String         @map("list_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  name         String
  brand        String?
  quantity     Decimal?       @db.Decimal(12, 3)
  unitPrice    Decimal?       @map("unit_price") @db.Decimal(12, 2)
  supermarket  String?
  purchased    Boolean        @default(false)
  sortOrder    Int            @default(0) @map("sort_order")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  list         ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  user         Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@index([userId])
  @@index([listId, purchased, sortOrder])
  @@map("products")
}

model PriceHistory {
  id          String        @id @default(uuid()) @db.Uuid
  legacyId    String?       @unique @map("legacy_id")
  userId      String        @map("user_id") @db.Uuid
  listId      String?       @map("list_id") @db.Uuid
  productId   String?       @map("product_id") @db.Uuid
  productName String        @map("product_name")
  brand       String?
  supermarket String?
  price       Decimal       @db.Decimal(12, 2)
  quantity    Decimal?      @db.Decimal(12, 3)
  createdAt   DateTime      @default(now()) @map("created_at")
  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([listId])
  @@index([productId])
  @@map("price_history")
}

model PasskeyCredential {
  id           String   @id @default(uuid()) @db.Uuid
  legacyId     String?  @unique @map("legacy_id")
  userId       String   @map("user_id") @db.Uuid
  credentialId String   @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  counter      BigInt   @default(0)
  deviceName   String?  @map("device_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}
