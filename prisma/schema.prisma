generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId           String?             @unique
  name               String
  email              String              @unique
  passwordHash       String
  securityAnswerHash String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lists              ShoppingList[]
  products           Product[]
  priceHistory       PriceHistory[]
  passkeys           PasskeyCredential[]
  sharedListAccess   SharedListAccess[]

  @@map("users")
}

enum ListAccessRole {
  VIEWER
  EDITOR
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model ShoppingList {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId  String?        @unique
  userId    String         @db.Uuid
  name      String
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  history   PriceHistory[]
  sharedAccess SharedListAccess[]

  @@index([userId])
  @@map("shopping_lists")
}

model SharedListAccess {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId    String         @db.Uuid
  userId    String         @db.Uuid
  role      ListAccessRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  list      ShoppingList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, userId])
  @@index([userId])
  @@map("shared_list_access")
}

model Product {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId    String?      @unique
  userId      String       @db.Uuid
  listId      String       @db.Uuid
  name        String
  brand       String       @default("")
  quantity    Decimal?     @db.Decimal(12, 3)
  unitPrice   Decimal?     @db.Decimal(12, 2)
  supermarket String       @default("")
  purchased   Boolean      @default(false) @map("isBought")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]

  @@index([userId])
  @@index([listId, purchased, sortOrder], map: "products_listId_isBought_sortOrder_idx")
  @@map("products")
}

model PriceHistory {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId    String?       @unique
  userId      String        @db.Uuid
  listId      String?       @db.Uuid
  productId   String?       @db.Uuid
  productName String
  brand       String        @default("")
  quantity    Decimal?      @db.Decimal(12, 3)
  price       Decimal       @db.Decimal(12, 2)
  supermarket String        @default("")
  createdAt   DateTime      @default(now()) @map("recordedAt")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "price_history_userId_recordedAt_idx")
  @@index([listId])
  @@index([productId])
  @@map("price_history")
}

model PasskeyCredential {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId   String?  @unique
  userId     String   @db.Uuid
  email      String
  rawId      String
  label      String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawId])
  @@index([userId])
  @@map("passkey_credentials")
}
