generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId           String?             @unique
  name               String
  email              String              @unique
  passwordHash       String
  securityAnswerHash String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  lists              ShoppingList[]
  products           Product[]
  priceHistory       PriceHistory[]
  passkeys           PasskeyCredential[]

  @@map("users")
}

model ShoppingList {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId  String?        @unique
  userId    String         @db.Uuid
  name      String
  color     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  history   PriceHistory[]

  @@index([userId])
  @@map("shopping_lists")
}

model Product {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId    String?      @unique
  userId      String       @db.Uuid
  listId      String       @db.Uuid
  name        String
  brand       String       @default("")
  quantity    Decimal?     @db.Decimal(12, 3)
  unitPrice   Decimal?     @db.Decimal(12, 2)
  supermarket String       @default("")
  isBought    Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listId, isBought, sortOrder])
  @@map("products")
}

model PriceHistory {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId    String?       @unique
  userId      String        @db.Uuid
  listId      String?       @db.Uuid
  productName String
  brand       String        @default("")
  price       Decimal       @db.Decimal(12, 2)
  supermarket String        @default("")
  recordedAt  DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  list        ShoppingList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  @@index([userId, recordedAt])
  @@index([listId])
  @@map("price_history")
}

model PasskeyCredential {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legacyId   String?  @unique
  userId     String   @db.Uuid
  email      String
  rawId      String
  label      String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rawId])
  @@index([userId])
  @@map("passkey_credentials")
}
